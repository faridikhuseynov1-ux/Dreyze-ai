{
	"name": "dreyze-ai",
	"displayName": "Dreyze AI Agent",
	"description": "Built-in AI Agent for Dreyze Code",
	"version": "1.0.0",
	"publisher": "dreyze",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Machine Learning",
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "dreyze-ai.startAgent",
				"title": "Dreyze AI: Open Agent Chat"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "dreyze-ai-sidebar",
					"title": "Dreyze AI",
					"icon": "$(hubot)"
				}
			]
		},
		"views": {
			"dreyze-ai-sidebar": [
				{
					"type": "webview",
					"id": "dreyze-ai.chatView",
					"name": "Agent Chat"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"dependencies": {
		"axios": "^1.6.8"
	},
	"devDependencies": {
		"@types/vscode": "^1.90.0",
		"@types/node": "^20.0.0",
		"typescript": "^5.4.5"
	}
}
